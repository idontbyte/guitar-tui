<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GuitarTuiSetup</AssemblyName>
    <ApplicationIcon>assets\GuitarTui.ico</ApplicationIcon>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\GuitarTui.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="payload\Guitar TUI.exe" LogicalName="GuitarTuiPayload" />
  </ItemGroup>

</Project>
